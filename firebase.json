{
  "hosting": {
    "public": "site/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      { "source": "/evidence/candidates/:slug", "destination": "/candidates/:slug", "type": 301 },
      { "source": "/evidence/candidates", "destination": "/candidates", "type": 301 },
      { "source": "/evidence/rejected/:slug", "destination": "/rejected/:slug", "type": 301 },
      { "source": "/evidence/rejected", "destination": "/rejected", "type": 301 },
      { "source": "/evidence/polling", "destination": "/polling", "type": 301 },
      { "source": "/evidence", "destination": "/candidates", "type": 301 },
      { "source": "/rejected/self-pardon-ban", "destination": "/candidates/self-pardon-ban", "type": 301 },
      { "source": "/q/a", "destination": "/", "type": 302 },
      { "source": "/q/b", "destination": "/get-involved/volunteer", "type": 302 },
      { "source": "/q/c", "destination": "https://www.linkedin.com/in/mrh2/", "type": 302 }
    ],
    "rewrites": [
      {
        "source": "/api/submit",
        "function": {
          "functionId": "submitForm",
          "region": "us-central1"
        }
      }
    ],
    "headers": [
      {
        "source": "**/*.@(woff2|png|jpg|jpeg|webp|avif|svg|ico)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "/_astro/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ]
  },
  "functions": {
    "source": "functions",
    "predeploy": ["npm --prefix functions run build"]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
