---
import '../styles/tokens.css';
import '../styles/global.css';
import { ogImageForPath } from '../lib/ogPages';
import SealMark from '../components/SealMark.astro';

interface Props {
  title: string;
  description?: string;
  /** Path of the share image (build-time PNG under /og/). Defaults to the
      page's own image when one exists, else the site-wide fallback. */
  ogImage?: string;
}

const {
  title,
  description = 'Constitutional amendments every American can agree on.',
  ogImage,
} = Astro.props;

const fullTitle =
  title === 'Home'
    ? 'New Bill of Rights Foundation'
    : `${title} — New Bill of Rights Foundation`;

const nav = [
  { href: '/mission', label: 'Mission' },
  { href: '/amendments', label: 'Amendments' },
  { href: '/candidates', label: 'Candidates' },
  { href: '/rejected', label: 'Rejected' },
  { href: '/scorecard', label: 'Scorecard' },
  { href: '/get-involved', label: 'Get Involved' },
  { href: '/about', label: 'About' },
];

const path = Astro.url.pathname;
const ogImageUrl = new URL(ogImage ?? ogImageForPath(path), Astro.site);
const canonicalUrl = new URL(path, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="New Bill of Rights Foundation" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — New Bill of Rights Foundation`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Favicons: generated by scripts/make-favicons.mjs from the brand tokens -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#1c2b3a" />
    <link
      rel="preload"
      href="/fonts/libre-caslon-text-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/public-sans-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      /* Analytics: Plausible (privacy-first, no cookies, no personal data).
         Production builds only, so local dev and previews don't count. */
      import.meta.env.PROD && (
        <script
          is:inline
          defer
          data-domain="newbillofrights.net"
          src="https://plausible.io/js/script.js"
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header>
      <div class="container header-inner">
        <a class="brand" href="/">
          <SealMark size="2.25rem" />
          <span class="brand-name">New&nbsp;Bill&nbsp;of&nbsp;Rights</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={
                      path.startsWith(item.href) ? 'page' : undefined
                    }
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a class="join" href="/get-involved#join">Join</a>
            </li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <div class="container">
        <div class="footer-lockup">
          <SealMark size="3rem" />
          <div>
            <p class="footer-brand">New Bill of Rights <span>Foundation</span></p>
            <p class="footer-thesis">
              Constitutional amendments every American can agree on.
            </p>
          </div>
        </div>
        <p>
          <a href="/get-involved#join">Join the mailing list</a>&ensp;·&ensp;<a
            href="/get-involved/volunteer">Volunteer</a>&ensp;·&ensp;<a
            href="/polling">Polling</a>&ensp;·&ensp;<a
            href="/about">Contact</a>&ensp;·&ensp;<a href="/faq">FAQ</a>
        </p>
        <p class="footer-fine">
          © 2026 New Bill of Rights Foundation (incorporation planned for
          2026). Its formation is funded by the
          <a href="/get-involved/seed-donors">seed donor round</a>.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  header {
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    flex-wrap: wrap;
    padding-block: var(--space-2);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-serif);
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: 0.01em;
  }

  .brand:hover .brand-name {
    color: var(--accent-text);
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    color: var(--ink);
    text-decoration: none;
    font-size: 0.95rem;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  nav a.join {
    background: var(--ink);
    color: var(--paper);
    padding: 0.35rem 0.9rem;
    border-radius: 3px;
  }

  nav a.join:hover {
    background: var(--accent-text);
    text-decoration: none;
  }

  main {
    min-height: 60vh;
    padding-block: var(--space-4);
  }

  footer {
    border-top: 1px solid var(--rule);
    background: var(--band);
    padding-block: var(--space-4);
    margin-top: var(--space-5);
  }

  .footer-lockup {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .footer-lockup p {
    margin: 0;
  }

  .footer-brand {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1.2;
  }

  .footer-brand span {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-left: 0.5rem;
  }

  .footer-thesis {
    font-family: var(--font-serif);
    font-size: var(--step-0);
    color: var(--ink-soft);
  }

  .footer-fine {
    font-size: 0.85rem;
    color: var(--ink-soft);
  }
</style>
