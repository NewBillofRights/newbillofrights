---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import AmendmentCard from '../components/AmendmentCard.astro';
import SeedDonorBand from '../components/SeedDonorBand.astro';
import FullSpectrumChart from '../components/FullSpectrumChart.astro';

const amendments = (await getCollection('amendments')).sort(
  (a, b) => a.data.order - b.data.order
);
const rejectedCount = (await getCollection('rejected')).length;
const spotlight = (await getCollection('polling'))[0];
---

<Base title="Home">
  <div class="container">
    <section class="hero">
      <h1>
        A new set of constitutional amendments that Americans across the entire
        political spectrum already agree on.
      </h1>
      <p class="pillars">Freedom · Democracy · Rule of Law · Good Government</p>
      <p class="hero-ctas">
        <a class="cta-primary" href="/get-involved#join">Join the mailing list</a>
        <a class="cta-secondary" href="/amendments">Read the amendments</a>
      </p>
    </section>

    <section class="spectrum">
      <div class="spectrum-copy">
        <h2>The full-spectrum test</h2>
        <p>
          Every proposal must clear a support floor in <em>both</em> parties —
          from MAGA Republicans to socialist Democrats — before it makes the
          list. If it can't, it doesn't matter how good the idea is: it's out.
        </p>
        <p>
          <a href="/evidence/polling">See the polling behind every proposal →</a>
        </p>
      </div>
      {
        spotlight && (
          <div class="spectrum-chart">
            <FullSpectrumChart
              proposal={
                spotlight.data.placeholder
                  ? `${spotlight.data.proposal} (illustrative — final numbers in Phase 2)`
                  : spotlight.data.proposal
              }
              support={spotlight.data.support}
            />
          </div>
        )
      }
    </section>

    <section>
      <h2>The eight amendments</h2>
      <div class="grid">
        {
          amendments.map((a) => (
            <AmendmentCard
              order={a.data.order}
              title={a.data.title}
              problemSummary={a.data.problemSummary}
              href={`/amendments/${a.id}`}
            />
          ))
        }
      </div>
    </section>

    <section class="work">
      <h2>We show our work</h2>
      <p>
        We've rejected {rejectedCount} categories that couldn't pass the
        full-spectrum bar — not because the issues don't matter, but because
        they can't yet clear it. Transparency about what didn't make the list
        is the point.
      </p>
      <p><a href="/evidence/rejected">See what we rejected, and why →</a></p>
    </section>
  </div>

  <SeedDonorBand />

  <div class="container">
    <section>
      <h2>The bar is the point</h2>
      <p>
        Amending the Constitution takes two-thirds of Congress and three-quarters
        of the states. That bar is why we only advance proposals with genuine
        support across the whole spectrum — anything less can't ratify, and
        shouldn't.
      </p>
      <p><a href="/mission">Read the mission →</a></p>
    </section>
  </div>
</Base>

<style>
  .hero {
    padding-block: var(--space-4);
  }

  .hero h1 {
    max-width: 52rem;
  }

  .pillars {
    font-family: var(--font-serif);
    color: var(--accent-text);
    font-size: var(--step-1);
    letter-spacing: 0.02em;
  }

  .hero-ctas {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .cta-primary,
  .cta-secondary {
    display: inline-block;
    padding: 0.6rem 1.2rem;
    border-radius: 3px;
    text-decoration: none;
    font-weight: 600;
  }

  .cta-primary {
    background: var(--ink);
    color: var(--paper);
  }

  .cta-primary:hover {
    background: var(--accent-text);
    color: var(--paper);
  }

  .cta-secondary {
    border: 1px solid var(--ink);
    color: var(--ink);
  }

  .cta-secondary:hover {
    border-color: var(--accent-text);
    color: var(--accent-text);
  }

  .spectrum,
  .work {
    margin-block: var(--space-4);
  }

  .spectrum {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    flex-wrap: wrap;
  }

  .spectrum-copy {
    flex: 1 1 24rem;
  }

  .spectrum-chart {
    flex: 0 1 24rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-2);
  }
</style>
