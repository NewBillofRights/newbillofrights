---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';

const rejected = (await getCollection('rejected')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base
  title="Rejected Categories"
  description="The categories that couldn't pass the full-spectrum test — the evidence, the test each failed, and what would bring it back."
>
  <div class="container">
    <h1>Rejected Categories</h1>
    <p>
      These aren't judgments that the issues don't matter — they're judgments
      that a category can't pass the full-spectrum test, and that including it
      would code the whole project as partisan. Each category below has its own
      page: the proposal as commonly framed, the best available evidence with
      party breakdowns, the specific test it failed, the framings we tested,
      and the path back. A rejected category can be revisited if survey or
      salon work reveals an unexpected consensus framing.
    </p>
    <ul class="rejected-list">
      {
        rejected.map((r) => (
          <li>
            <h2>
              <a href={`/evidence/rejected/${r.id}`}>{r.data.title}</a>
            </h2>
            <p class="meta">
              Rejected {r.data.rejectedOn} · <span class="test">{r.data.failedTest}</span>
            </p>
            <p>{r.data.summary}</p>
          </li>
        ))
      }
    </ul>
    <p>
      Also see the <a href="/evidence/candidates">candidate categories</a> —
      the open pipeline of ideas under consideration — and the
      <a href="/evidence/polling">polling evidence</a>. How categories are
      accepted, held, or rejected is described on the
      <a href="/mission">mission page</a>.
    </p>
  </div>
</Base>

<style>
  .rejected-list {
    list-style: none;
    padding: 0;
    max-width: var(--measure);
  }

  .rejected-list li {
    border-bottom: 1px solid var(--rule);
    padding-block: var(--space-3);
  }

  .rejected-list h2 {
    font-size: var(--step-1);
    margin-bottom: 0.25rem;
  }

  .rejected-list h2 a {
    text-decoration: none;
  }

  .rejected-list h2 a:hover {
    text-decoration: underline;
  }

  .meta {
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin: 0 0 var(--space-1);
  }

  .test {
    font-family: var(--font-serif);
    color: var(--accent-text);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.75rem;
  }
</style>
