---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';

export async function getStaticPaths() {
  const rejected = await getCollection('rejected');
  return rejected.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base
  title={`${entry.data.title} — Rejected`}
  description={entry.data.summary}
  ogImage={`/og/rejected/${entry.id}.png`}
>
  <div class="container">
    <article>
      <header class="rejected-header">
        <p class="kicker">Rejected category · {entry.data.failedTest}</p>
        <h1>{entry.data.title}</h1>
        <p class="lede">{entry.data.summary}</p>
        <p class="meta">
          Rejected {entry.data.rejectedOn}. A rejection is not a judgment that
          the issue doesn't matter — it is a judgment that the category cannot
          pass the <a href="/mission">full-spectrum test</a> today. The evidence,
          the test, and the path back are below.
        </p>
      </header>
      <Content />
      <p class="back"><a href="/evidence/rejected">← All rejected categories</a></p>
    </article>
  </div>
</Base>

<style>
  .kicker {
    font-family: var(--font-serif);
    color: var(--accent-text);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.85rem;
    margin-bottom: var(--space-1);
  }

  .lede {
    font-size: var(--step-1);
    color: var(--ink-soft);
  }

  .meta {
    font-size: 0.9rem;
    color: var(--ink-soft);
    max-width: var(--measure);
  }

  .rejected-header {
    border-bottom: 1px solid var(--rule);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .back {
    margin-top: var(--space-4);
  }
</style>
