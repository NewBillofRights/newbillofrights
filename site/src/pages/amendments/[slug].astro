---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const amendments = await getCollection('amendments');
  return amendments.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base
  title={entry.data.title}
  description={entry.data.problemSummary}
  ogImage={`/og/amendments/${entry.id}.png`}
>
  <div class="container">
    <article>
      <header class="amendment-header">
        <p class="kicker">
          Amendment {String(entry.data.order).padStart(2, '0')}
        </p>
        <h1>{entry.data.title}</h1>
        <p class="lede">{entry.data.principleSummary}</p>
      </header>
      <Content />
      <p class="back"><a href="/amendments">← All amendments</a></p>
    </article>
  </div>
</Base>

<style>
  .kicker {
    font-family: var(--font-serif);
    color: var(--accent-text);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.85rem;
    margin-bottom: var(--space-1);
  }

  .lede {
    font-size: var(--step-1);
    color: var(--ink-soft);
  }

  .amendment-header {
    border-bottom: 1px solid var(--rule);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .back {
    margin-top: var(--space-4);
  }
</style>
