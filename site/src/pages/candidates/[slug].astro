---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const candidates = await getCollection('candidates');
  return candidates.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base
  title={`${entry.data.title} — Candidate`}
  description={entry.data.summary}
  ogImage={`/og/candidates/${entry.id}.png`}
>
  <div class="container">
    <article>
      <header class="candidate-header">
        <p class="kicker">Candidate category · {entry.data.gate}</p>
        <h1>{entry.data.title}</h1>
        <p class="lede">{entry.data.summary}</p>
        <p class="meta">
          Under consideration since {entry.data.candidateSince}. A candidate is
          neither accepted nor rejected — it is waiting on evidence against the
          <a href="/mission">full-spectrum test</a>. What we know, what we
          don't, and what would move it are below.
        </p>
      </header>
      <Content />
      <p class="back"><a href="/candidates">← All candidates</a></p>
    </article>
  </div>
</Base>

<style>
  .kicker {
    font-family: var(--font-serif);
    color: var(--accent-text);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.85rem;
    margin-bottom: var(--space-1);
  }

  .lede {
    font-size: var(--step-1);
    color: var(--ink-soft);
  }

  .meta {
    font-size: 0.9rem;
    color: var(--ink-soft);
    max-width: var(--measure);
  }

  .candidate-header {
    border-bottom: 1px solid var(--rule);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .back {
    margin-top: var(--space-4);
  }
</style>
