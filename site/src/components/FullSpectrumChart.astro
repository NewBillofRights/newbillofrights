---
/**
 * The signature graphic: per-proposal support among Democrats, Republicans,
 * and independents, with the proposal's bipartisan floor — the lower of the
 * two parties' support — labeled on the chart. No threshold line is drawn
 * (decision 2026-08-17: label each proposal's floor number instead). Static
 * build-time SVG — no client JS. All bars wear the single gold accent
 * deliberately: party identity comes from the labels, never from red/blue.
 */
interface Support {
  dem: number;
  rep: number;
  ind?: number;
  overall?: number;
}

interface Props {
  proposal: string;
  support: Support;
  /** Hide the floor annotation (e.g., when the caption already states it). */
  showFloor?: boolean;
}

const { proposal, support, showFloor = true } = Astro.props;

// The bipartisan floor is the lower of the two parties' support.
const floor = Math.min(support.dem, support.rep);
const floorParty = support.rep <= support.dem ? 'Republicans' : 'Democrats';

const bars = [
  { key: 'Dem', label: 'Democrats', value: support.dem },
  { key: 'Rep', label: 'Republicans', value: support.rep },
  ...(support.ind != null
    ? [{ key: 'Ind', label: 'Independents', value: support.ind }]
    : []),
];

// geometry
const W = 340;
const H = 198;
const PAD = { top: 34, right: 10, bottom: 26, left: 10 };
const plotW = W - PAD.left - PAD.right;
const plotH = H - PAD.top - PAD.bottom;
const barW = 48;
const slot = plotW / bars.length;
const y = (v: number) => PAD.top + plotH - (v / 100) * plotH;
const baseline = PAD.top + plotH;
const R = 4; // rounded data-end radius

// bar path: rounded top corners, square base (data-end rounding only)
function barPath(cx: number, v: number): string {
  const x0 = cx - barW / 2;
  const top = y(v);
  const h = baseline - top;
  const r = Math.min(R, h);
  return [
    `M ${x0} ${baseline}`,
    `L ${x0} ${top + r}`,
    `Q ${x0} ${top} ${x0 + r} ${top}`,
    `L ${x0 + barW - r} ${top}`,
    `Q ${x0 + barW} ${top} ${x0 + barW} ${top + r}`,
    `L ${x0 + barW} ${baseline}`,
    'Z',
  ].join(' ');
}

const summary = `${proposal}: ${bars
  .map((b) => `${b.label} ${b.value}%`)
  .join(', ')}. Bipartisan floor ${floor}% (${floorParty}).`;
---

<figure class="fsc">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-label={summary}
    xmlns="http://www.w3.org/2000/svg"
  >
    <!-- baseline -->
    <line
      x1={PAD.left}
      y1={baseline}
      x2={W - PAD.right}
      y2={baseline}
      class="axis"
    ></line>

    {
      bars.map((b, i) => {
        const cx = PAD.left + slot * i + slot / 2;
        return (
          <g>
            <path d={barPath(cx, b.value)} class="bar">
              <title>{`${b.label}: ${b.value}%`}</title>
            </path>
            <text x={cx} y={y(b.value) - 7} text-anchor="middle" class="value">
              {b.value}%
            </text>
            <text x={cx} y={baseline + 17} text-anchor="middle" class="cat">
              {b.key}
            </text>
          </g>
        );
      })
    }

    {
      showFloor && (
        <text x={W - PAD.right} y={13} text-anchor="end" class="floor-label">
          bipartisan floor · {floor}% ({floorParty})
        </text>
      )
    }
  </svg>
  <figcaption>{proposal}</figcaption>
</figure>

<style>
  .fsc {
    margin: 0;
    max-width: 24rem;
  }

  svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .bar {
    fill: var(--accent);
  }

  .axis {
    stroke: var(--rule);
    stroke-width: 1;
  }

  .value {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    fill: var(--ink);
  }

  .cat {
    font-family: var(--font-sans);
    font-size: 12px;
    fill: var(--ink-soft);
  }

  .floor-label {
    font-family: var(--font-sans);
    font-size: 11.5px;
    font-weight: 600;
    fill: var(--ink);
  }

  figcaption {
    font-size: 0.9rem;
    color: var(--ink-soft);
    margin-top: var(--space-1);
    max-width: 24rem;
  }
</style>
