---
/**
 * The signature graphic: per-proposal support among Democrats, Republicans,
 * and independents, drawn against the bipartisan floor. Static build-time
 * SVG — no client JS. All bars wear the single gold accent deliberately:
 * party identity comes from the labels, never from red/blue coding.
 */
interface Support {
  dem: number;
  rep: number;
  ind?: number;
  overall?: number;
}

interface Props {
  proposal: string;
  support: Support;
  /** Support floor each party must clear. Provisional default until the
      foundation's official floor definition lands (Phase 2). */
  floor?: number;
}

const { proposal, support, floor = 50 } = Astro.props;

const bars = [
  { key: 'Dem', label: 'Democrats', value: support.dem },
  { key: 'Rep', label: 'Republicans', value: support.rep },
  ...(support.ind != null
    ? [{ key: 'Ind', label: 'Independents', value: support.ind }]
    : []),
];

// geometry
const W = 340;
const H = 190;
const PAD = { top: 26, right: 10, bottom: 26, left: 10 };
const plotW = W - PAD.left - PAD.right;
const plotH = H - PAD.top - PAD.bottom;
const barW = 48;
const slot = plotW / bars.length;
const y = (v: number) => PAD.top + plotH - (v / 100) * plotH;
const baseline = PAD.top + plotH;
const floorY = y(floor);
const R = 4; // rounded data-end radius

// bar path: rounded top corners, square base (data-end rounding only)
function barPath(cx: number, v: number): string {
  const x0 = cx - barW / 2;
  const top = y(v);
  const h = baseline - top;
  const r = Math.min(R, h);
  return [
    `M ${x0} ${baseline}`,
    `L ${x0} ${top + r}`,
    `Q ${x0} ${top} ${x0 + r} ${top}`,
    `L ${x0 + barW - r} ${top}`,
    `Q ${x0 + barW} ${top} ${x0 + barW} ${top + r}`,
    `L ${x0 + barW} ${baseline}`,
    'Z',
  ].join(' ');
}

const summary = `${proposal}: ${bars
  .map((b) => `${b.label} ${b.value}%`)
  .join(', ')} — all above the ${floor}% bipartisan floor.`;
---

<figure class="fsc">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-label={summary}
    xmlns="http://www.w3.org/2000/svg"
  >
    <!-- baseline -->
    <line
      x1={PAD.left}
      y1={baseline}
      x2={W - PAD.right}
      y2={baseline}
      class="axis"
    ></line>

    {
      bars.map((b, i) => {
        const cx = PAD.left + slot * i + slot / 2;
        return (
          <g>
            <path d={barPath(cx, b.value)} class="bar">
              <title>{`${b.label}: ${b.value}%`}</title>
            </path>
            <text x={cx} y={y(b.value) - 7} text-anchor="middle" class="value">
              {b.value}%
            </text>
            <text x={cx} y={baseline + 17} text-anchor="middle" class="cat">
              {b.key}
            </text>
          </g>
        );
      })
    }

    <!-- bipartisan floor: drawn above bars so it reads as the gate -->
    <line
      x1={PAD.left}
      y1={floorY}
      x2={W - PAD.right}
      y2={floorY}
      class="floor"
    ></line>
    <text x={W - PAD.right} y={floorY - 6} text-anchor="end" class="floor-label">
      bipartisan floor · {floor}%
    </text>
  </svg>
  <figcaption>{proposal}</figcaption>
</figure>

<style>
  .fsc {
    margin: 0;
    max-width: 24rem;
  }

  svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .bar {
    fill: var(--accent);
  }

  .axis {
    stroke: var(--rule);
    stroke-width: 1;
  }

  .floor {
    stroke: var(--ink);
    stroke-width: 2;
    stroke-dasharray: 7 5;
  }

  .value {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    fill: var(--ink);
  }

  .cat {
    font-family: var(--font-sans);
    font-size: 12px;
    fill: var(--ink-soft);
  }

  .floor-label {
    font-family: var(--font-sans);
    font-size: 11.5px;
    font-weight: 600;
    fill: var(--ink);
    /* paper halo so the label stays legible where it crosses a bar */
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  figcaption {
    font-size: 0.9rem;
    color: var(--ink-soft);
    margin-top: var(--space-1);
    max-width: 24rem;
  }
</style>
