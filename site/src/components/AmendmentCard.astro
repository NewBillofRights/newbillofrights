---
interface Props {
  order: number;
  title: string;
  problemSummary: string;
  href: string;
  /** Heading level for the card title — match the surrounding outline
      (h3 under an h2 section on Home; h2 directly under the h1 on /amendments). */
  headingLevel?: 'h2' | 'h3';
}

const { order, title, problemSummary, href, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<a class="card" href={href}>
  <span class="num">{String(order).padStart(2, '0')}</span>
  <Heading class="card-title">{title}</Heading>
  <p>{problemSummary}</p>
</a>

<style>
  .card {
    display: block;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: var(--space-3);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 120ms ease;
  }

  .card:hover {
    border-color: var(--accent);
  }

  .num {
    font-family: var(--font-serif);
    color: var(--accent-text);
    font-size: 0.9rem;
    letter-spacing: 0.1em;
  }

  .card .card-title {
    font-size: var(--step-1);
    margin: var(--space-1) 0;
  }

  .card p {
    color: var(--ink-soft);
    font-size: 0.95rem;
    margin: 0;
  }
</style>
